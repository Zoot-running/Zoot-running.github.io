    <title>本地插件安装</title>
    <link>https://quartz.jzhao.xyz/%E7%9F%A5%E8%AF%86%E7%AE%A1%E7%90%86/Obsidian%E4%BD%BF%E7%94%A8/%E6%9C%AC%E5%9C%B0%E6%8F%92%E4%BB%B6%E5%AE%89%E8%A3%85</link>
